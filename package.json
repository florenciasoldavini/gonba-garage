{
  "name": "gonba-garage",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ignore-pattern .next --ignore-pattern dist --ignore-pattern .vinext",
    "test": "vitest run && npm run test:alerts && npm run test:price-alert-delivery && npm run test:inventory-alert-delivery",
    "test:watch": "vitest",
    "test:live": "TEST_LIVE=1 vitest run tests/vehicles/vehicle-attributes.test.mjs",
    "test:attributes": "vitest run tests/vehicles/vehicle-attributes.test.mjs",
    "test:integration": "vitest run tests/mercado-libre",
    "test:alerts": "node scripts/check-alert-storage.mjs",
    "test:price-alert-delivery": "node scripts/check-price-alert-delivery.mjs",
    "test:inventory-alert-delivery": "node scripts/check-inventory-alert-delivery.mjs",
    "test:metadata": "node scripts/check-social-metadata.mjs",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node scripts/migrate-alerts.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@neondatabase/serverless": "^1.2.0",
    "@vercel/blob": "2.8.2",
    "gsap": "^3.15.0",
    "lucide-react": "1.34.0",
    "next": "^16.4.3",
    "posthog-js": "^1.444.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.4.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@vercel/cli-config": {
      "zod": "4.6.7"
    }
  },
  "type": "module"
}
