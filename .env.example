# Mercado Libre OAuth application. Never commit real values.
MERCADO_LIBRE_CLIENT_ID=
MERCADO_LIBRE_CLIENT_SECRET=
MERCADO_LIBRE_REDIRECT_URI=
MERCADO_LIBRE_SELLER_ID=

# Optional server-only Arg Autos key. Anonymous access has a low rate limit.
ARGAUTOS_API_KEY=

# Public origin used for canonical URLs and social metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Keep false for demos and previews. Set true only when the production site is ready for indexing.
SITE_INDEXING_ENABLED=false

# PostHog browser analytics. Leave the token empty to disable analytics.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Enable only after reviewing replay privacy settings in the PostHog project.
NEXT_PUBLIC_POSTHOG_SESSION_REPLAY=false

# Optional HTML-tag verification for Google Search Console.
# DNS verification is preferred once the production domain is available.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Supabase. The publishable values are safe in the browser when RLS is enabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only key for trusted inventory synchronization. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
