# Neon PostgreSQL, server only. Use development locally and production only on Vercel Production.
DATABASE_URL=

# Mercado Libre OAuth application. Never commit real values.
MERCADO_LIBRE_CLIENT_ID=
MERCADO_LIBRE_CLIENT_SECRET=
MERCADO_LIBRE_REDIRECT_URI=
MERCADO_LIBRE_SELLER_ID=
# Vercel backend only: random 32-byte key encoded as base64. Keep outside Blob.
MERCADO_LIBRE_TOKEN_ENCRYPTION_KEY=
# Connect a PRIVATE Blob store to the backend project (OIDC + BLOB_STORE_ID).
BLOB_STORE_ID=
# Same random private key on Vercel and localhost; never NEXT_PUBLIC_.
MERCADO_LIBRE_CATALOG_API_KEY=
# Local server only: fixed production Vercel origin. The site always shows the real Mercado Libre
# catalog: through this backend locally, or from its own synced copy in DATABASE_URL when unset (as
# on Vercel). See docs/mercado-libre-local.md.
MERCADO_LIBRE_BACKEND_URL=https://gonba-garage.vercel.app

# Optional server-only Arg Autos key. Anonymous access has a low rate limit.
ARGAUTOS_API_KEY=

# Public origin used for canonical URLs and social metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Keep false locally and on previews. Set true only when the production site is ready for indexing.
SITE_INDEXING_ENABLED=false

# PostHog browser analytics. Leave the token empty to disable analytics.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Enable only after reviewing replay privacy settings in the PostHog project.
NEXT_PUBLIC_POSTHOG_SESSION_REPLAY=false

# Optional HTML-tag verification for Google Search Console.
# DNS verification is preferred once the production domain is available.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Alert emails (price drops and search alerts). There is no on/off switch: alerts are offered and
# sent wherever DATABASE_URL and these four are set, and hidden everywhere else. Leave them unset
# locally and on previews unless you are testing with ALERTS_TEST_RECIPIENT.
RESEND_API_KEY=
ALERTS_EMAIL_FROM=
# Fixed HTTPS origin for vehicle links and cancellation (never derived from request headers).
ALERTS_PUBLIC_URL=
# At least 32 random characters, server only. Keep stable to preserve confirmation/cancellation links.
# Also keys the hashed per-IP and per-email signup limits; set it wherever DATABASE_URL is set.
ALERTS_SIGNING_SECRET=
# Authorizes the Vercel crons: daily alerts and Mercado Libre catalog reconciliation.
CRON_SECRET=
# Optional safety restriction for preview/local tests. Never redirect other recipients here.
ALERTS_TEST_RECIPIENT=
